node_modules/
dist/
.gobeyond/
coverage/
*.log
.DS_Store
.env
.env.*
!.env.example

# Route-owned Go is authored under app/ but compiled only from generated,
# import-safe packages. Per-route go.mod files exist solely for Go tooling.
**/app/**/go.mod
**/workers/**/go.mod

# Ephemeral projections and process mains under generated/. Committed
# artifacts are routes/routes_gen.go and contracts/** only.
**/generated/routes/*/
**/generated/api/
**/generated/workers/
**/generated/cmd/
**/generated/registry/

# Legacy projection roots (removed by generate).
**/.generated/
**/internal/gobeyondgen/
