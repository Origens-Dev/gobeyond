{
  "name": "@go-beyond/vite",
  "version": "0.1.0-alpha.14",
  "description": "Exact client-boundary transforms for GoBeyond Vite builds",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Origens-Dev/gobeyond.git",
    "directory": "packages/vite"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vite": ">=7.0.0 <9.0.0"
  },
  "devDependencies": {
    "@go-beyond/compiler": "workspace:*",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
